     void AppendBuffer(SinkBuffer& buffer, std::span<s16> samples) override {
         // If SDL could not open a device, no callback will drain the queue.
-        // Discard audio as the null sink does so the ADSP cannot block forever.
+        // Discard audio as the null sink does so the ADSP cannot block forever, but at the device
+        // rate: returning at once lets the audio renderer spin unpaced, starving the game threads
+        // on smaller CPUs (blue window, game never reaches its first frame).
         if (stream == nullptr) {
+            using Clock = std::chrono::steady_clock;
+            const auto now = Clock::now();
+            if (silent_frames == 0 || now > silent_due + std::chrono::milliseconds(200)) {
+                silent_start = now;
+                silent_frames = 0;
+            }
+            silent_frames += buffer.frames;
+            silent_due = silent_start + std::chrono::nanoseconds(silent_frames * 1'000'000'000ULL /
+                                                                 TargetSampleRate);
+            std::this_thread::sleep_until(silent_due);
             return;
         }
         SinkStream::AppendBuffer(buffer, samples);
