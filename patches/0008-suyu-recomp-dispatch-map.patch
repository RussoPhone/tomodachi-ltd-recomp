 // Refuse the JIT entirely. Without this, "the JIT was never reached" is an
 // observation about one run; with it, reaching the JIT is a loud, fatal failure
 // that names the address, which is the difference between evidence and proof.
+// SWITCHPILER lab patch 0008: optional map of every PC the dispatcher enters, for measuring which
+// functions a title really reaches through indirect calls (e.g. the graphics driver's entry points).
+// SUYU_RECOMP_DISPATCH_MAP=<file> enables it; the set is a lock-free open-addressing table and is
+// rewritten as "<module base hex>\t<module name>" / "<pc hex>" lines every few seconds. Off by default.
+namespace DispatchMap {
+constexpr size_t kSlots = size_t{1} << 21;
+const char* const kPath = [] {
+    const char* e = std::getenv("SUYU_RECOMP_DISPATCH_MAP");
+    return (e && *e) ? e : nullptr;
+}();
+std::atomic<u64>* Table() {
+    static std::atomic<u64>* table = kPath ? new std::atomic<u64>[kSlots]() : nullptr;
+    return table;
+}
+void Dump();
+inline void Note(u64 pc) {
+    std::atomic<u64>* table = Table();
+    if (!table || pc == 0) {
+        return;
+    }
+    size_t i = static_cast<size_t>((pc >> 2) * 0x9E3779B97F4A7C15ULL >> 43) & (kSlots - 1);
+    for (size_t probe = 0; probe < 64; ++probe, i = (i + 1) & (kSlots - 1)) {
+        u64 cur = table[i].load(std::memory_order_relaxed);
+        if (cur == pc) {
+            break;
+        }
+        if (cur == 0 && table[i].compare_exchange_strong(cur, pc, std::memory_order_relaxed)) {
+            break;
+        }
+        if (cur == pc) {
+            break;
+        }
+    }
+    static std::atomic<s64> last{0};
+    const s64 now = std::chrono::duration_cast<std::chrono::seconds>(
+                        std::chrono::steady_clock::now().time_since_epoch()).count();
+    s64 prev = last.load(std::memory_order_relaxed);
+    if (now - prev >= 5 && last.compare_exchange_strong(prev, now)) {
+        Dump();
+    }
+}
+} // namespace DispatchMap
