+void DispatchMap::Dump() {
+    std::atomic<u64>* table = Table();
+    if (!table) {
+        return;
+    }
+    std::string text;
+    {
+        std::scoped_lock lk{g_counters.hist_lock};
+        for (const auto& [base, name] : g_counters.modules) {
+            text += fmt::format("module\t{:#x}\t{}\n", base, name);
+        }
+    }
+    for (size_t i = 0; i < kSlots; ++i) {
+        if (const u64 pc = table[i].load(std::memory_order_relaxed)) {
+            text += fmt::format("{:#x}\n", pc);
+        }
+    }
+    const std::string tmp = std::string{kPath} + ".tmp";
+    if (std::FILE* f = std::fopen(tmp.c_str(), "w")) {
+        std::fwrite(text.data(), 1, text.size(), f);
+        std::fclose(f);
+        std::rename(tmp.c_str(), kPath);
+    }
+}
