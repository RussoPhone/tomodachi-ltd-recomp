     constexpr size_t kBlocksPerUnit = 20000;
-    const size_t unit_count =
-        blocks.empty() ? 1 : (blocks.size() + kBlocksPerUnit - 1) / kBlocksPerUnit;
+    // SWITCHPILER lab patch 0002: optionally also close a unit once it holds
+    // SUYU_AOT_UNIT_INSNS guest instructions. Block counts alone let a unit of
+    // unusually long blocks reach hundreds of megabytes of C, and the compiler
+    // needs roughly 100 MB of heap per MB of it at any optimisation level.
+    // Unset or 0 keeps the upstream layout exactly.
+    size_t insns_per_unit = 0;
+    if (const char* env = std::getenv("SUYU_AOT_UNIT_INSNS")) {
+        insns_per_unit = static_cast<size_t>(std::strtoull(env, nullptr, 10));
+    }
+    std::vector<size_t> unit_begin{0};
+    {
+        size_t in_unit = 0, insns = 0;
+        for (size_t i = 0; i < blocks.size(); ++i) {
+            if (in_unit == kBlocksPerUnit ||
+                (insns_per_unit != 0 && in_unit != 0 && insns + blocks[i].count > insns_per_unit)) {
+                unit_begin.push_back(i);
+                in_unit = 0;
+                insns = 0;
+            }
+            ++in_unit;
+            insns += blocks[i].count;
+        }
+        unit_begin.push_back(blocks.size());
+    }
+    const size_t unit_count = blocks.empty() ? 1 : unit_begin.size() - 1;
+    if (blocks.empty()) {
+        unit_begin.assign({0, 0});
+    }
