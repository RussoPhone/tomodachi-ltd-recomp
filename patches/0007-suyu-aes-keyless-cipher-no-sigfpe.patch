     if (size == 0)
         return;
 
+    // SWITCHPILER lab patch 0007: a cipher built from an all-zero (absent) key is left
+    // uninitialized on purpose (see the constructor), but callers can still reach here - e.g.
+    // Loader::IdentifyFile probing a non-NCA file as an NCA without keys, or an NCA whose key
+    // generation the keyset lacks. Its block size is then 0 and the modulo below divided by zero
+    // (SIGFPE). Produce zeros instead: the caller's magic/hash checks then reject the data cleanly.
+    if (EVP_CIPHER_CTX_get0_cipher(context) == nullptr) {
+        std::memset(dest, 0, size);
+        return;
+    }
+
     // reset
     ASSERT(EVP_CipherInit_ex(context, nullptr, nullptr, nullptr, nullptr, -1));
 
